// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  syncedCases  SyncedCaseBlob[]
  syncedTasks  SyncedTaskBlob[]
}

model SyncedCaseBlob {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  entityId  String     // ID from frontend
  encryptedData String  // AES-encrypted clinical case data
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  @@unique([userId, entityId])
  @@index([userId])
}

model SyncedTaskBlob {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  entityId  String     // ID from frontend
  caseId    String?
  encryptedData String  // AES-encrypted task data
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  @@unique([userId, entityId])
  @@index([userId])
}
